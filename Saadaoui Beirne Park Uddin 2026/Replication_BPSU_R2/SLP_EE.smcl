. // Wald test for religious tensions regimes
. 
. forvalues v = 0(1)5{
  2. 
. qui locproj bonds_tw D3#c.Dvul100, lcs(1.D3#c.Dvul100) ///
>  h(`v') yl(1) sl(1) ///
